{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "factoryascent:item/electric_drill_icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "factoryascent:drill_charged",
      "on_false": {
        "type": "minecraft:model",
        "model": "factoryascent:item/electric_drill_3d"
      },
      "on_true": {
        "type": "minecraft:condition",
        "property": "factoryascent:drilling",
        "on_true": {
          "type": "minecraft:model",
          "model": "factoryascent:item/electric_drill_3d_spinning"
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "factoryascent:item/electric_drill_3d_charged"
        }
      }
    }
  }
}
